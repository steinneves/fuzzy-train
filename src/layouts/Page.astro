---
import { Header, Button, Footer } from '@components/odyssey-theme';
import Layout from './Base.astro';
import type { Props as BaseHeadProps } from '../components/head/BaseHead.astro';
import Logo from '../components/Logo.astro';
import LangToggle from '../components/LangToggle.astro';
import BookingModal from '../components/BookingModal.astro';
import LanguageChooser from '../components/LanguageChooser.astro';
import Fab from '../components/Fab.astro';
import T from '../components/T.astro';
import settings from '../config/settings';
import { footerLists, footerSocials } from '../config/footer';

export interface Props {
	seo?: BaseHeadProps;
}

import { nav } from '../config/nav.js';

const { seo } = Astro.props as Props;
---

<Layout seo={seo}>
	<Header rightMenu navData={nav} slot="header">
		<span slot="logo">
			<Logo />
		</span>
		<div slot="action-item" class="header-actions">
			<LangToggle />
			<Button type="button" data-open-booking><T en="Book a lesson" pt="Agendar aula" /></Button>
		</div>
	</Header>
	<div id="page">
		<slot />
	</div>
	<Fab />
	<LanguageChooser />
	<BookingModal />
	<Footer
		slot="footer"
		background="var(--theme-surface-1)"
		color="var(--theme-on-surface-1)"
		footerLists={footerLists}
		footerSocials={footerSocials}
		copyrightName={settings.name}
		showPlug={settings.showPlug}
	>
		<Logo slot="logo" />
	</Footer>
</Layout>

<script>
	// Scroll-reveal for sections marked .reveal (content stays visible without JS).
	document.documentElement.classList.add('js');
	const revealEls = document.querySelectorAll('.reveal');
	const showEl = (el) => el.classList.add('is-visible');
	if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const io = new IntersectionObserver(
			(entries) =>
				entries.forEach((e) => {
					if (e.isIntersecting) {
						showEl(e.target);
						io.unobserve(e.target);
					}
				}),
			{ threshold: 0.12 }
		);
		revealEls.forEach((el) => io.observe(el));
	} else {
		revealEls.forEach(showEl);
	}

	// Close the mobile menu when a menu link is tapped.
	const header = document.getElementById('odysseyNavHeader');
	const menuButton = document.getElementById('menuButton');
	document.querySelectorAll('#odysseyNavHeader nav a').forEach((a) =>
		a.addEventListener('click', () => {
			if (header?.hasAttribute('mobile-menu-open')) menuButton?.click();
		})
	);
</script>

<style is:global>
	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	@media (max-width: 860px) {
		.header-actions {
			gap: 0.4rem;
		}
		.header-actions .btn {
			padding: 0.3rem 0.7rem;
			font-size: var(--font-size-sm);
		}
	}
</style>
