---
import { Icon } from 'astro-icon/components';
import { Container, Button } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import T from '../components/T.astro';
import settings from '../config/settings.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const wa = (msg) => `https://wa.me/${settings.whatsapp}?text=${encodeURIComponent(msg)}`;
const waEn = wa("Hi! I'd like to book a trial Portuguese lesson.");
const waPt = wa('Olá! Gostaria de agendar uma aula experimental de inglês.');

const usd = `US$${settings.priceUsd}`;
const brl = `R$${settings.priceBrl}`;

const chips = [
	{ icon: 'mdi:account-voice', en: 'One-on-one', pt: 'Aulas individuais' },
	{ icon: 'mdi:clock-outline', en: `${usd} / hour`, pt: `${brl} / hora` },
	{ icon: 'mdi:tune-variant', en: 'Custom packages', pt: 'Pacotes personalizados' },
	{ icon: 'mdi:map-marker-outline', en: 'Online or in person', pt: 'Online ou presencial' },
];

const formats = [
	{
		icon: 'mdi:video-outline',
		title: { en: 'Online', pt: 'Online' },
		text: { en: 'Lessons by video call, from wherever you are.', pt: 'Aulas por videochamada, de onde você estiver.' },
	},
	{
		icon: 'mdi:map-marker-outline',
		title: { en: 'In person', pt: 'Presencial' },
		text: {
			en: 'I can come to you if you are in the Vila Velha, ES area.',
			pt: 'Posso ir até você se estiver na região de Vila Velha, ES.',
		},
	},
];

const packages = [
	{
		icon: 'mdi:clock-outline',
		plan: 'Trial lesson',
		name: { en: 'Trial lesson', pt: 'Aula experimental' },
		price: { en: usd, pt: brl },
		unit: { en: 'per hour', pt: 'por hora' },
		text: {
			en: 'Try one hour with no commitment. A good way to meet, set a baseline and decide how to continue.',
			pt: 'Experimente uma hora, sem compromisso. Uma boa forma de nos conhecermos, definir seu ponto de partida e decidir como continuar.',
		},
	},
	{
		icon: 'mdi:calendar-check-outline',
		plan: 'Lesson package',
		name: { en: 'Lesson package', pt: 'Pacote de aulas' },
		price: { en: usd, pt: brl },
		unit: { en: 'per hour', pt: 'por hora' },
		text: {
			en: 'A block of hours with a steady weekly rhythm, so you build momentum and keep it.',
			pt: 'Um bloco de horas com ritmo semanal constante, para você ganhar embalo e manter.',
		},
	},
	{
		icon: 'mdi:tune-variant',
		plan: 'Custom package',
		name: { en: 'Custom package', pt: 'Pacote personalizado' },
		price: { en: 'Tailored', pt: 'Sob medida' },
		unit: { en: 'built around you', pt: 'feito para você' },
		text: {
			en: 'Travel, moving to Brazil, work, conversation or exam prep. Content and schedule designed for your goal.',
			pt: 'Entrevistas de emprego, viagens, provas, conversação ou inglês para negócios. Conteúdo e horários planejados para o seu objetivo.',
		},
		featured: true,
		badge: { en: 'Customizable', pt: 'Personalizável' },
	},
];

const steps = [
	{
		icon: 'mdi:chat-processing-outline',
		title: { en: 'Tell me your goal', pt: 'Conte seu objetivo' },
		text: {
			en: 'Send me a message with what you want to use Portuguese for.',
			pt: 'Envie uma mensagem dizendo para que você quer usar o inglês.',
		},
	},
	{
		icon: 'mdi:clipboard-text-outline',
		title: { en: 'We build your plan', pt: 'Montamos seu plano' },
		text: {
			en: 'We agree on a package, schedule and focus areas that fit your needs.',
			pt: 'Combinamos pacote, horários e focos que se encaixam nas suas necessidades.',
		},
	},
	{
		icon: 'mdi:rocket-launch-outline',
		title: { en: 'Learn and practice', pt: 'Aprenda e pratique' },
		text: {
			en: 'One-on-one lessons, online or in person, with practical material, feedback and steady progress.',
			pt: 'Aulas individuais, online ou presenciais, com material prático, feedback e progresso constante.',
		},
	},
];

const provider = { '@type': 'Organization', name: settings.name, url: settings.url };
const offer = (price, currency) => ({
	'@type': 'Offer',
	priceCurrency: currency,
	priceSpecification: { '@type': 'UnitPriceSpecification', price, priceCurrency: currency, unitText: 'HOUR' },
});
const areaServed = [{ '@type': 'City', name: 'Vila Velha' }, { '@type': 'AdministrativeArea', name: 'Espírito Santo' }];
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{ '@type': 'Service', areaServed, name: 'English lessons for Brazilians', serviceType: 'English as a Second Language lessons', provider, offers: offer(settings.priceBrl, 'BRL') },
		{ '@type': 'Service', areaServed, name: 'Portuguese lessons for foreigners', serviceType: 'Portuguese language lessons', provider, offers: offer(settings.priceUsd, 'USD') },
	],
};
---

<Layout>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

	<Container>
		<section class="hero">
			<div class="hero__text">
				<p class="eyebrow"><T en="Portuguese tutoring" pt="Aulas de inglês" /></p>
				<h1><T en="Portuguese lessons built around you" pt="Aulas de inglês feitas sob medida para você" /></h1>
				<p>
					<T
						en={`One-on-one Portuguese tutoring with lesson packages designed for your goals, schedule and level. ${usd} per hour.`}
						pt={`Aulas particulares de inglês com pacotes pensados para seus objetivos, sua rotina e seu nível. ${brl} por hora.`}
					/>
				</p>
				<ul class="chips" aria-label="Highlights" data-pt-aria-label="Destaques">
					{chips.map((c) => (
						<li class="chip"><Icon name={c.icon} width="18" height="18" /> <T en={c.en} pt={c.pt} /></li>
					))}
				</ul>
				<div class="btn-row">
					<Button type="button" data-open-booking><T en="Book a lesson" pt="Agendar aula" /></Button>
					<Button href={waEn} data-pt-href={waPt} data-wa newTab customIcon>
						<T en="Message on WhatsApp" pt="Chamar no WhatsApp" />
						<Fragment slot="icon"><Icon name="mdi:whatsapp" width="20" height="20" /></Fragment>
					</Button>
				</div>
			</div>
			<div class="hero__image">
				<picture>
					<img
						src={`${base}/assets/images/home/classic-hero.jpg`}
						alt=""
						width="1080"
						height="1104"
						fetchpriority="high"
					/>
				</picture>
			</div>
		</section>
	</Container>

	<Container>
		<section id="packages" class="section reveal">
			<h2><T en="Lesson packages" pt="Pacotes de aulas" /></h2>
			<p><T en="Every student is different, so every package can be adjusted." pt="Cada aluno é diferente, então todo pacote pode ser ajustado." /></p>
			<div class="grid">
				{packages.map((p) => (
					<article class:list={['card', { 'card--featured': p.featured }]}>
						{p.badge && <span class="badge"><T en={p.badge.en} pt={p.badge.pt} /></span>}
						<span class="icon-circle"><Icon name={p.icon} width="24" height="24" /></span>
						<h3><T en={p.name.en} pt={p.name.pt} /></h3>
						<p class="price"><T en={p.price.en} pt={p.price.pt} /> <span><T en={p.unit.en} pt={p.unit.pt} /></span></p>
						<p class="card__text"><T en={p.text.en} pt={p.text.pt} /></p>
						<Button type="button" data-open-booking data-plan={p.plan} data-plan-pt={p.name.pt} outlined={!p.featured} onPrimary={p.featured}>
							<T en="Ask about this" pt="Quero saber mais" />
						</Button>
					</article>
				))}
			</div>
		</section>
	</Container>

	<Container>
		<section id="format" class="section reveal">
			<h2><T en="Online or in person" pt="Online ou presencial" /></h2>
			<div class="grid grid--two">
				{formats.map((f) => (
					<article class="card">
						<span class="icon-circle"><Icon name={f.icon} width="24" height="24" /></span>
						<h3><T en={f.title.en} pt={f.title.pt} /></h3>
						<p><T en={f.text.en} pt={f.text.pt} /></p>
					</article>
				))}
			</div>
		</section>
	</Container>

	<Container>
		<section id="about" class="section about reveal">
			<div class="about__photo">
				<img
					src={`${base}/assets/images/about/tutor-photo.jpg`}
					alt="Your tutor"
					data-pt-alt="Seu tutor"
					width="900"
					height="1100"
					loading="lazy"
				/>
			</div>
			<div class="about__text">
				<h2><T en="About me" pt="Sobre mim" /></h2>
				<p><T en="Lessons planned for you, one student at a time." pt="Aulas planejadas para você, um aluno de cada vez." /></p>
				<figure class="about__page">
					<img
						src={`${base}/assets/images/about/lesson-page.jpg`}
						alt="A sample lesson page"
						data-pt-alt="Exemplo de página de aula"
						width="900"
						height="1180"
						loading="lazy"
					/>
					<figcaption><T en="A sample lesson page" pt="Exemplo de página de aula" /></figcaption>
				</figure>
			</div>
		</section>
	</Container>

	<Container>
		<section id="how-it-works" class="section reveal">
			<h2><T en="How it works" pt="Como funciona" /></h2>
			<ol class="grid steps">
				{steps.map((s, i) => (
					<li class="step">
						<span class="step__n">{i + 1}</span>
						<Icon name={s.icon} width="28" height="28" />
						<h3><T en={s.title.en} pt={s.title.pt} /></h3>
						<p><T en={s.text.en} pt={s.text.pt} /></p>
					</li>
				))}
			</ol>
		</section>
	</Container>

	<Container>
		<section id="contact" class="section contact reveal">
			<h2><T en="Ready to start?" pt="Pronto para começar?" /></h2>
			<p><T en="Tell me what you want to achieve and I will suggest a plan." pt="Conte o que você quer alcançar e eu sugiro um plano." /></p>
			<div class="contact__grid">
				<a class="contact__tile contact__tile--wa" href={waEn} data-pt-href={waPt} target="_blank" rel="noopener noreferrer">
					<Icon name="mdi:whatsapp" width="32" height="32" />
					<span class="contact__label">WhatsApp</span>
					<span class="contact__value">{settings.whatsappDisplay}</span>
				</a>
				<button type="button" class="contact__tile" data-open-booking>
					<Icon name="mdi:email-outline" width="32" height="32" />
					<span class="contact__label"><T en="Send a message" pt="Enviar mensagem" /></span>
					<span class="contact__value"><T en="Opens a short form" pt="Abre um formulário curto" /></span>
				</button>
			</div>
		</section>
	</Container>

	<a class="fab" href={waEn} data-pt-href={waPt} target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp" data-pt-aria-label="Conversar no WhatsApp">
		<Icon name="mdi:whatsapp" width="28" height="28" />
	</a>
</Layout>

<script>
	document.documentElement.classList.add('js');
	const els = document.querySelectorAll('.reveal');
	const show = (el) => el.classList.add('is-visible');
	if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const io = new IntersectionObserver(
			(entries) =>
				entries.forEach((e) => {
					if (e.isIntersecting) {
						show(e.target);
						io.unobserve(e.target);
					}
				}),
			{ threshold: 0.12 }
		);
		els.forEach((el) => io.observe(el));
	} else {
		els.forEach(show);
	}
</script>

<style>
	.hero {
		margin: var(--section-margin) auto;
		min-height: clamp(70vh, 70vw, calc(100vh - var(--navbar-height)));
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: 1rem;
	}
	.hero__text {
		justify-self: center;
		max-width: 28rem;
	}
	.eyebrow {
		margin: 0 0 0.5rem;
		font-size: var(--font-size-sm);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.72;
	}
	.chips {
		margin: 1.25rem 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.8rem;
		border-radius: 3rem;
		background-color: var(--theme-surface-2);
		color: var(--theme-on-surface-2);
		font-size: var(--font-size-sm);
		font-weight: 700;
	}
	.btn-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
	}
	.hero__image img {
		display: block;
		width: 100%;
		height: auto;
		max-height: 70vh;
		object-fit: cover;
		border-radius: var(--theme-shape-radius);
	}
	.section {
		margin: var(--section-margin) auto;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--theme-grid-gap);
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	.grid--two {
		grid-template-columns: repeat(2, 1fr);
	}
	.card,
	.step {
		position: relative;
		padding: 1.5rem;
		background-color: var(--theme-surface-1);
		color: var(--theme-on-surface-1);
		border-radius: var(--theme-shape-radius);
		transition: transform var(--theme-transition), box-shadow var(--theme-transition);
	}
	.card:hover,
	.step:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 24px rgb(0 0 0 / 0.12);
	}
	.card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}
	.card h3,
	.step h3 {
		margin: 0.75rem 0 0;
	}
	.card__text {
		flex: 1;
		margin-bottom: 1.25rem;
	}
	.card--featured {
		background-color: var(--theme-primary);
		color: var(--theme-on-primary);
	}
	.badge {
		position: absolute;
		top: 1rem;
		right: 1rem;
		padding: 0.15rem 0.7rem;
		border-radius: 3rem;
		background-color: var(--theme-surface-2);
		color: var(--theme-on-surface-2);
		font-size: var(--font-size-sm);
		font-weight: 700;
	}
	.icon-circle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		background-color: var(--theme-surface-2);
		color: var(--theme-on-surface-2);
	}
	.price {
		font-size: var(--font-size-lg);
		font-weight: 700;
		margin: 0.25rem 0 0.75rem;
	}
	.price span {
		font-size: var(--font-size-sm);
		font-weight: 400;
		opacity: 0.72;
	}
	.step__n {
		position: absolute;
		top: 1rem;
		right: 1.25rem;
		font-size: var(--font-size-xl);
		font-weight: 700;
		opacity: 0.18;
		line-height: 1;
	}
	.contact__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--theme-grid-gap);
		margin-top: 1.5rem;
	}
	.contact__tile {
		font: inherit;
		text-align: left;
		border: none;
		cursor: pointer;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.25rem;
		padding: 1.5rem;
		background-color: var(--theme-surface-2);
		color: var(--theme-on-surface-2);
		border-radius: var(--theme-shape-radius);
		text-decoration: none;
		transition: transform var(--theme-transition), box-shadow var(--theme-transition);
		overflow-wrap: anywhere;
	}
	.contact__tile:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 24px rgb(0 0 0 / 0.12);
	}
	.contact__label {
		font-weight: 700;
		margin-top: 0.5rem;
	}
	.contact__value {
		font-size: var(--font-size-md);
	}

	.about {
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: 2rem;
		align-items: center;
	}
	.about__photo img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--theme-shape-radius);
		object-fit: cover;
	}
	.about__page {
		margin: 1.5rem 0 0;
		max-width: 18rem;
		transform: rotate(-2deg);
		transition: transform var(--theme-transition);
	}
	.about__page:hover {
		transform: rotate(0deg) scale(1.03);
	}
	.about__page img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
		box-shadow: 0 12px 30px rgb(0 0 0 / 0.25);
	}
	.about__page figcaption {
		margin-top: 0.75rem;
		font-size: var(--font-size-sm);
		opacity: 0.72;
	}
	.contact__tile--wa {
		background-color: #25d366;
		color: #000;
	}
	.fab {
		position: fixed;
		right: 1rem;
		bottom: 1rem;
		z-index: 80;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 50%;
		background-color: #25d366;
		color: #000;
		box-shadow: 0 6px 18px rgb(0 0 0 / 0.3);
		transition: transform var(--theme-transition);
	}
	.fab:hover {
		transform: scale(1.08);
	}
	:global(.js) .reveal:not(.is-visible) {
		opacity: 0;
		transform: translateY(1.5rem);
	}
	.reveal {
		transition: opacity 0.6s ease, transform 0.6s ease;
	}
	@media (max-width: 768px) {
		.hero {
			grid-template-columns: 1fr;
		}
		.grid,
		.grid--two,
		.contact__grid,
		.about {
			grid-template-columns: 1fr;
		}
	}
</style>
