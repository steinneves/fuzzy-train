---
import { Icon } from 'astro-icon/components';
import { Container, Button } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import T from '../components/T.astro';
import CtaSection from '../components/CtaSection.astro';
import Testimonials from '../components/Testimonials.astro';
import ExploreSection from '../components/ExploreSection.astro';
import settings from '../config/settings.js';
import { waEn, waPt } from '../config/links.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');


const usd = `US$${settings.priceUsd}`;
const brl = `R$${settings.priceBrl}`;

const chips = [
	{ icon: 'mdi:account-voice', en: 'One-on-one', pt: 'Aulas individuais' },
	{ icon: 'mdi:clock-outline', en: `${usd} / hour`, pt: `${brl} / hora` },
	{ icon: 'mdi:tune-variant', en: 'Custom packages', pt: 'Pacotes personalizados' },
];

const packages = [
	{
		icon: 'mdi:clock-outline',
		plan: 'Trial lesson',
		name: { en: 'Trial lesson', pt: 'Aula experimental' },
		price: { en: usd, pt: brl },
		unit: { en: 'per hour', pt: 'por hora' },
		text: {
			en: 'Try one hour with no commitment. A good way to meet, set a baseline and decide how to continue.',
			pt: 'Experimente uma hora, sem compromisso. Uma boa forma de nos conhecermos, definir seu ponto de partida e decidir como continuar.',
		},
	},
	{
		icon: 'mdi:calendar-check-outline',
		plan: 'Lesson package',
		name: { en: 'Lesson package', pt: 'Pacote de aulas' },
		price: { en: usd, pt: brl },
		unit: { en: 'per hour', pt: 'por hora' },
		text: {
			en: 'A block of hours with a steady weekly rhythm, so you build momentum and keep it.',
			pt: 'Um bloco de horas com ritmo semanal constante, para você ganhar embalo e manter.',
		},
	},
	{
		icon: 'mdi:tune-variant',
		plan: 'Custom package',
		name: { en: 'Custom package', pt: 'Pacote personalizado' },
		price: { en: 'Tailored', pt: 'Sob medida' },
		unit: { en: 'built around you', pt: 'feito para você' },
		text: {
			en: 'Travel, moving to Brazil, work, conversation or exam prep. Content and schedule designed for your goal.',
			pt: 'Entrevistas de emprego, viagens, provas, conversação ou inglês para negócios. Conteúdo e horários planejados para o seu objetivo.',
		},
		featured: true,
		badge: { en: 'Customizable', pt: 'Personalizável' },
	},
];

const steps = [
	{
		icon: 'mdi:chat-processing-outline',
		title: { en: 'Tell me your goal', pt: 'Conte seu objetivo' },
		text: {
			en: 'Send me a message with what you want to use Portuguese for.',
			pt: 'Envie uma mensagem dizendo para que você quer usar o inglês.',
		},
	},
	{
		icon: 'mdi:clipboard-text-outline',
		title: { en: 'We build your plan', pt: 'Montamos seu plano' },
		text: {
			en: 'We agree on a package, schedule and focus areas that fit your needs.',
			pt: 'Combinamos pacote, horários e focos que se encaixam nas suas necessidades.',
		},
	},
	{
		icon: 'mdi:rocket-launch-outline',
		title: { en: 'Learn and practice', pt: 'Aprenda e pratique' },
		text: {
			en: 'One-on-one online lessons with practical material, feedback and steady progress.',
			pt: 'Aulas individuais online com material prático, feedback e progresso constante.',
		},
	},
];

const provider = { '@type': 'Organization', name: settings.name, url: settings.url };
const offer = (price, currency) => ({
	'@type': 'Offer',
	priceCurrency: currency,
	priceSpecification: { '@type': 'UnitPriceSpecification', price, priceCurrency: currency, unitText: 'HOUR' },
});
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{ '@type': 'Service', name: 'English lessons for Brazilians', serviceType: 'English as a Second Language lessons', provider, offers: offer(settings.priceBrl, 'BRL') },
		{ '@type': 'Service', name: 'Portuguese lessons for foreigners', serviceType: 'Portuguese language lessons', provider, offers: offer(settings.priceUsd, 'USD') },
	],
};
---

<Layout>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

	<Container>
		<section class="hero">
			<div class="hero__text">
				<p class="eyebrow"><T en="Portuguese tutoring" pt="Aulas de inglês" /></p>
				<h1><T en="Portuguese lessons built around you" pt="Aulas de inglês feitas sob medida para você" /></h1>
				<p>
					<T
						en={`One-on-one Portuguese tutoring with lesson packages designed for your goals, schedule and level. ${usd} per hour.`}
						pt={`Aulas particulares de inglês com pacotes pensados para seus objetivos, sua rotina e seu nível. ${brl} por hora.`}
					/>
				</p>
				<ul class="chips" aria-label="Highlights" data-pt-aria-label="Destaques">
					{chips.map((c) => (
						<li class="chip"><Icon name={c.icon} width="18" height="18" /> <T en={c.en} pt={c.pt} /></li>
					))}
				</ul>
				<div class="btn-row">
					<Button type="button" data-open-booking><T en="Book a lesson" pt="Agendar aula" /></Button>
					<Button href={waEn} data-pt-href={waPt} data-wa newTab customIcon>
						<T en="Message on WhatsApp" pt="Chamar no WhatsApp" />
						<Fragment slot="icon"><Icon name="mdi:whatsapp" width="20" height="20" /></Fragment>
					</Button>
				</div>
			</div>
			<div class="hero__image">
				<picture>
					<img
						src={`${base}/assets/images/home/classic-hero.jpg`}
						alt=""
						width="1080"
						height="1104"
						fetchpriority="high"
					/>
				</picture>
			</div>
		</section>
	</Container>

	<div class="band band--tint">
	<Container>
		<section id="how-it-works" class="section reveal">
			<h2 class="section-title"><T en="How it works" pt="Como funciona" /></h2>
			<ol class="grid steps">
				{steps.map((s, i) => (
					<li class="step">
						<span class="step__n">{i + 1}</span>
						<Icon name={s.icon} width="28" height="28" />
						<h3><T en={s.title.en} pt={s.title.pt} /></h3>
						<p><T en={s.text.en} pt={s.text.pt} /></p>
					</li>
				))}
			</ol>
		</section>
	</Container>
	</div>

	<div class="band">
	<Container>
		<section id="packages" class="section reveal">
			<h2 class="section-title"><T en="Lesson packages" pt="Pacotes de aulas" /></h2>
			<p class="section-intro"><T en="Every student is different, so every package can be adjusted." pt="Cada aluno é diferente, então todo pacote pode ser ajustado." /></p>
			<div class="grid">
				{packages.map((p) => (
					<article class:list={['card', { 'card--featured': p.featured }]}>
						{p.badge && <span class="badge"><T en={p.badge.en} pt={p.badge.pt} /></span>}
						<span class="icon-circle"><Icon name={p.icon} width="24" height="24" /></span>
						<h3><T en={p.name.en} pt={p.name.pt} /></h3>
						<p class="price"><T en={p.price.en} pt={p.price.pt} /> <span><T en={p.unit.en} pt={p.unit.pt} /></span></p>
						<p class="card__text"><T en={p.text.en} pt={p.text.pt} /></p>
						<Button type="button" data-open-booking data-plan={p.plan} data-plan-pt={p.name.pt} outlined={!p.featured} onPrimary={p.featured}>
							<T en="Ask about this" pt="Quero saber mais" />
						</Button>
					</article>
				))}
			</div>
		</section>
	</Container>
	</div>

	<Testimonials />

	<div class="band">
	<Container>
		<section class="section callout reveal">
			<div>
				<h2><T en="Not sure of your level?" pt="Não sabe qual é o seu nível?" /></h2>
				<p><T en="Take the quick level check. It takes about two minutes." pt="Faça o teste de nível rápido. Leva cerca de dois minutos." /></p>
			</div>
			<Button href={`${base}/level-check/`}><T en="Take the level check" pt="Fazer o teste de nível" /></Button>
		</section>
	</Container>
	</div>

	<ExploreSection exclude={['packages', 'level-check']} />

	<CtaSection />
</Layout>

<style>
	.hero {
		margin: var(--section-margin) auto;
		min-height: clamp(70vh, 70vw, calc(100vh - var(--navbar-height)));
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		gap: 1rem;
	}
	.hero__text {
		justify-self: center;
		max-width: 28rem;
	}
	.chips {
		margin: 1.25rem 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.8rem;
		border-radius: 3rem;
		background-color: var(--theme-surface-2);
		color: var(--theme-on-surface-2);
		font-size: var(--font-size-sm);
		font-weight: 700;
	}
	.btn-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
	}
	.hero__image img {
		display: block;
		width: 100%;
		height: auto;
		max-height: 70vh;
		object-fit: cover;
		border-radius: var(--theme-shape-radius);
	}
	@media (max-width: 768px) {
		.hero {
			grid-template-columns: 1fr;
		}
	}
</style>
