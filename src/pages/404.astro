---
import { Button, Container, TextCardSection } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import T from '../components/T.astro';

const seo = {
	title: 'Page not found | Stein Tutoring',
	description: 'Page not found.',
};
---

<Layout {seo}>
	<Container>
		<TextCardSection>
			<h1>404</h1>
			<h2><T en="Page not found" pt="Página não encontrada" /></h2>
			<div class="cta-buttons__container">
				<Button href={import.meta.env.BASE_URL}><T en="Return home" pt="Voltar ao início" /></Button>
			</div>
		</TextCardSection>
	</Container>
</Layout>

<style>
	.cta-buttons__container {
		display: flex;
		flex-wrap: wrap;
	}
	.cta-buttons__container :global(a) {
		margin-right: 1rem;
		margin-bottom: 1rem;
	}
	.code-buttons__container {
		margin: 1rem auto;
		display: flex;
		flex-wrap: wrap;
	}
	.code-buttons__container > a {
		margin-right: 1rem;
		margin-bottom: 1rem;
	}
</style>
