---
import { Icon } from 'astro-icon/components';
import { Container } from '@components/odyssey-theme';
import T from './T.astro';
import settings from '../config/settings.js';
import { waEn, waPt } from '../config/links.js';
---

<Container>
	<section id="contact" class="section cta reveal">
		<h2 class="section-title"><T en="Ready to start?" pt="Pronto para começar?" /></h2>
		<p><T en="Tell me what you want to achieve and I will suggest a plan." pt="Conte o que você quer alcançar e eu sugiro um plano." /></p>
		<div class="contact__grid">
			<a class="contact__tile contact__tile--wa" href={waEn} data-pt-href={waPt} target="_blank" rel="noopener noreferrer">
				<span class="contact__icon"><Icon name="mdi:whatsapp" width="26" height="26" /></span>
				<span class="contact__text">
					<span class="contact__label">WhatsApp</span>
					<span class="contact__value">{settings.whatsappDisplay}</span>
				</span>
				<Icon class="contact__arrow" name="mdi:arrow-right" width="22" height="22" />
			</a>
			<button type="button" class="contact__tile" data-open-booking>
				<span class="contact__icon"><Icon name="mdi:email-outline" width="26" height="26" /></span>
				<span class="contact__text">
					<span class="contact__label"><T en="Send a message" pt="Enviar mensagem" /></span>
					<span class="contact__value"><T en="Opens a short form" pt="Abre um formulário curto" /></span>
				</span>
				<Icon class="contact__arrow" name="mdi:arrow-right" width="22" height="22" />
			</button>
		</div>
	</section>
</Container>
