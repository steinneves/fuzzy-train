---
import { Icon } from 'astro-icon/components';
import { Button } from '@components/odyssey-theme';
import T from './T.astro';
import settings from '../config/settings.js';

const endpoint = settings.formEndpoint || '';
const wa = (msg) => `https://wa.me/${settings.whatsapp}?text=${encodeURIComponent(msg)}`;
const waEn = wa("Hi! I'd like to book a Portuguese lesson.");
const waPt = wa('Olá! Gostaria de agendar uma aula de inglês.');
---

<dialog id="booking" aria-labelledby="booking-title">
	<button type="button" class="booking__close" data-close-booking aria-label="Close" data-pt-aria-label="Fechar">&times;</button>
	<h2 id="booking-title"><T en="Book a lesson" pt="Agendar aula" /></h2>
	<p><T en="Tell me a bit about what you need." pt="Conte um pouco do que você precisa." /></p>

	<form id="booking-form" data-endpoint={endpoint} data-wa={settings.whatsapp} novalidate={false}>
		<input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
		<label>
			<span><T en="Name" pt="Nome" /></span>
			<input type="text" name="name" required autocomplete="name" />
		</label>
		<input type="hidden" name="plan" value="" />
		<label>
			<span><T en="Email or phone number" pt="E-mail ou telefone" /></span>
			<input type="text" name="contact" required autocomplete="email" />
		</label>
		<label>
			<span><T en="Message" pt="Mensagem" /></span>
			<textarea name="message" rows="4" required></textarea>
		</label>
		<Button type="submit"><T en="Send message" pt="Enviar mensagem" /></Button>
		<p class="status" role="status" aria-live="polite">
			<span data-s="ok"><T en="Thanks! I will get back to you soon." pt="Obrigado! Responderei em breve." /></span>
			<span data-s="err"><T en="Something went wrong. Please try WhatsApp instead." pt="Algo deu errado. Tente pelo WhatsApp." /></span>
		</p>
	</form>

	<div class="booking__or" aria-hidden="true"><span><T en="or" pt="ou" /></span></div>

	<Button href={waEn} data-pt-href={waPt} data-wa newTab customIcon>
		<T en="Message me on WhatsApp" pt="Chamar no WhatsApp" />
		<Fragment slot="icon"><Icon name="mdi:whatsapp" width="22" height="22" /></Fragment>
	</Button>
</dialog>

<script>
	const dlg = document.getElementById('booking');
	const form = document.getElementById('booking-form');

	document.addEventListener('click', (e) => {
		const opener = e.target.closest('[data-open-booking]');
		if (opener) {
			e.preventDefault();
			form.elements.plan.value = opener.dataset.plan || '';
			const pt = document.documentElement.getAttribute('data-lang') === 'pt';
			const label = pt ? opener.dataset.planPt : opener.dataset.plan;
			const msg = form.elements.message;
			// Prefill, but never overwrite something the visitor typed.
			if (!msg.value.trim() || msg.dataset.prefilled === 'true') {
				msg.value = label
					? pt ? `Tenho interesse em: ${label}.` : `I'm interested in: ${label}.`
					: pt ? 'Tenho interesse em agendar uma aula.' : "I'm interested in booking a lesson.";
				msg.dataset.prefilled = 'true';
			}
			form.removeAttribute('data-state');
			dlg.showModal();
			return;
		}
		if (e.target.closest('[data-close-booking]') || e.target === dlg) dlg.close();
	});

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		const data = new FormData(form);
		if (data.get('_gotcha')) return;
		// Formspree uses a field named "email" as the reply-to address.
		if (String(data.get('contact')).includes('@')) data.append('email', String(data.get('contact')));
		const endpoint = form.dataset.endpoint;
		if (!endpoint) {
			const pt = document.documentElement.getAttribute('data-lang') === 'pt';
			const text = pt
				? `Olá! Meu nome é ${data.get('name')} (${data.get('contact')}). ${data.get('message')}`
				: `Hi! I'm ${data.get('name')} (${data.get('contact')}). ${data.get('message')}`;
			window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
			dlg.close();
			form.reset();
			delete form.elements.message.dataset.prefilled;
			return;
		}
		try {
			const res = await fetch(endpoint, {
				method: 'POST',
				body: data,
				headers: { Accept: 'application/json' },
			});
			form.setAttribute('data-state', res.ok ? 'ok' : 'err');
			if (res.ok) {
				form.reset();
				delete form.elements.message.dataset.prefilled;
			}
		} catch (err) {
			form.setAttribute('data-state', 'err');
		}
	});
</script>

<style>
	dialog {
		width: calc(100% - 2rem);
		max-width: 32rem;
		padding: 1.5rem;
		border: none;
		border-radius: var(--theme-shape-radius);
		background-color: var(--theme-bg);
		color: var(--theme-on-bg);
		box-shadow: 0 20px 60px rgb(0 0 0 / 0.35);
	}
	dialog::backdrop {
		background: rgb(0 0 0 / 0.55);
	}
	dialog h2 {
		margin-top: 0;
	}
	.booking__close {
		position: absolute;
		top: 0.75rem;
		right: 1rem;
		border: none;
		background: transparent;
		color: inherit;
		font-size: 2rem;
		line-height: 1;
		cursor: pointer;
	}
	form {
		display: grid;
		gap: 1rem;
	}
	label {
		display: grid;
		gap: 0.25rem;
		font-weight: 700;
		font-size: var(--font-size-sm);
	}
	input,
	select,
	textarea {
		width: 100%;
		padding: 0.6rem 0.8rem;
		border: 2px solid var(--theme-surface-2);
		border-radius: 0.75rem;
		background-color: var(--theme-bg);
		color: var(--theme-on-bg);
		font: inherit;
		font-weight: 400;
	}
	input:focus,
	select:focus,
	textarea:focus {
		border-color: var(--theme-primary);
	}
	.hp {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
	}
	.status span {
		display: none;
	}
	form[data-state='ok'] [data-s='ok'],
	form[data-state='err'] [data-s='err'] {
		display: inline;
	}
	.status {
		margin: 0;
		min-height: 1.5rem;
	}
	.booking__or {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin: 0.5rem 0 1rem;
		font-size: var(--font-size-sm);
		opacity: 0.72;
	}
	.booking__or::before,
	.booking__or::after {
		content: '';
		flex: 1;
		height: 1px;
		background: currentColor;
		opacity: 0.4;
	}
	dialog > :global(.btn) {
		width: 100%;
		padding-block: 0.95rem;
	}
	form > :global(.btn) {
		justify-self: center;
	}
</style>
