---
// Decorative greeting that cross-fades between languages, like a "hello" boot screen.
---

<p class="greeting" aria-hidden="true">
	<span class="greeting__word">Hello</span>
	<span class="greeting__word greeting__word--b">Olá</span>
</p>

<style>
	.greeting {
		display: grid;
		margin: 0 0 0.25rem;
		font-family: var(--theme-font-family-serif);
		font-style: italic;
		font-weight: 700;
		font-size: var(--font-size-lg);
		line-height: 1.1;
		min-height: 1.2em;
	}
	.greeting__word {
		grid-area: 1 / 1;
		opacity: 0;
		animation: greet 6s ease-in-out infinite both;
	}
	.greeting__word--b {
		animation-delay: 3s;
	}
	@keyframes greet {
		0% {
			opacity: 0;
			filter: blur(10px);
			transform: translateY(8px) scale(0.96);
		}
		10%,
		42% {
			opacity: 1;
			filter: blur(0);
			transform: none;
		}
		52%,
		100% {
			opacity: 0;
			filter: blur(10px);
			transform: translateY(-8px) scale(1.04);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.greeting {
			display: flex;
			gap: 0.75rem;
		}
		.greeting__word {
			animation: none;
			opacity: 1;
		}
		.greeting__word--b::before {
			content: '·';
			margin-right: 0.75rem;
			opacity: 0.5;
		}
	}
</style>
