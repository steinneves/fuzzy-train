---
import settings from '../../config/settings.js';

import '../../styles/index.css';

export interface Props {
	title?: string;
	titlePt?: string;
	description?: string;
	canonicalURL?: URL | string;
	image?: string;
}

const title = Astro.props.title || settings.title;
const titlePt = Astro.props.titlePt || settings.titlePt;
const description = Astro.props.description || settings.description;
const canonicalURL = Astro.props.canonicalURL || new URL(Astro.url.pathname, Astro.site);
const image = new URL(Astro.props.image || `${import.meta.env.BASE_URL}/social.png`.replace(/\/\//g, '/'), Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/favicon.png`.replace(/\/\//g, '/')} />
<!-- Language bootstrap (runs before paint).
     Saved choice or ?lang=pt|en wins. Otherwise we guess from browser language and time zone
     (so Brazilians with an English browser are still detected) and show the chooser. -->
<script is:inline>
	(function () {
		var root = document.documentElement;
		try {
			var valid = function (v) { return v === 'pt' || v === 'en'; };
			var qs = new URLSearchParams(location.search).get('lang');
			if (valid(qs)) { try { localStorage.setItem('lang', qs); } catch (e) {} }
			var saved = null;
			try { saved = localStorage.getItem('lang'); } catch (e) {}
			var chosen = valid(qs) ? qs : valid(saved) ? saved : null;

			var br = ['America/Sao_Paulo','America/Bahia','America/Fortaleza','America/Recife','America/Belem','America/Manaus','America/Cuiaba','America/Campo_Grande','America/Porto_Velho','America/Boa_Vista','America/Rio_Branco','America/Araguaina','America/Maceio','America/Santarem','America/Noronha','America/Eirunepe'];
			var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
			var ptBrowser = langs.some(function (x) { return String(x).toLowerCase().indexOf('pt') === 0; });
			var tz = '';
			try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
			var guess = ptBrowser || br.indexOf(tz) !== -1 ? 'pt' : 'en';

			var lang = chosen || guess;
			root.setAttribute('data-lang', lang);
			root.setAttribute('data-guess', guess);
			root.lang = lang === 'pt' ? 'pt-BR' : 'en';
			if (!chosen) root.setAttribute('data-chooser', '');
		} catch (e) {}
	})();
</script>
<meta name="theme-color" content="#000000" />
<meta name="title-pt" content={titlePt} />
<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<!-- Generator -->
<meta name="generator" content={Astro.generator} />
<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />


<!-- Google Analytics -->
<script>
  var host = window.location.hostname;
  if(host != 'localhost') {
    // Place Google Analytics code here.
  }
</script>
