---
// "Meet your tutor" strip under the home hero. Uses placeholder text and a silhouette until
// content.photo and content.intro are filled in (src/config/content.js).
import { Container, Button } from '@components/odyssey-theme';
import T from './T.astro';
import content from '../config/content.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (p) => `${base}/${p.replace(/^\//, '')}`;
const photo = content.photo ? path(content.photo) : path('assets/images/about/tutor-filler.jpg');
const intro = {
	en: content.intro.en || "Hi, I'm Stein. I plan every lesson around your goals, level and schedule.",
	pt: content.intro.pt || 'Olá, eu sou Stein. Planejo cada aula em torno dos seus objetivos, nível e rotina.',
};
---

<Container>
	<section class="meet reveal">
		<img class="meet__photo" src={photo} alt="Your tutor" data-pt-alt="Seu tutor" width="400" height="400" loading="lazy" />
		<div class="meet__text">
			<p class="eyebrow"><T en="Meet your tutor" pt="Conheça seu tutor" /></p>
			<p class="meet__intro"><T en={intro.en} pt={intro.pt} /></p>
		</div>
		<Button href={`${base}/about/`} outlined><T en="Meet me" pt="Conheça mais" /></Button>
	</section>
</Container>

<style>
	.meet {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem 1.75rem;
		margin: 0 auto var(--section-margin);
		padding: 1.5rem 2rem;
		border: 2px solid rgb(0 0 0 / 0.12);
		border-radius: var(--theme-shape-radius);
		background: var(--theme-bg);
	}
	.meet__photo {
		flex: none;
		width: 6rem;
		height: 6rem;
		border-radius: 50%;
		object-fit: cover;
		border: 3px solid var(--theme-primary);
	}
	.meet__text {
		flex: 1;
		min-width: 14rem;
	}
	.meet__text .eyebrow {
		margin-bottom: 0.25rem;
	}
	.meet__intro {
		margin: 0;
		font-size: var(--font-size-md);
		font-family: var(--theme-font-family-serif);
		line-height: 1.3;
	}
	@media (max-width: 600px) {
		.meet {
			flex-direction: column;
			text-align: center;
			padding: 1.5rem 1rem;
		}
	}
</style>
